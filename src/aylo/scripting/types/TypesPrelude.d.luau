declare class Entity
	bits: number
end

declare class AssetId
end

type Vec2 = { x: number, y: number }
type Vec3 = { x: number, y: number, z: number }
type Vec4 = { x: number, y: number, z: number, w: number }
type Fields = { [string]: any }
type Phase = "Startup" | "PreUpdate" | "FixedUpdate" | "Update" | "PostUpdate" | "Render"
type Side = "server" | "client" | "both"
type Time = { delta: number, fixedDelta: number, elapsed: number, tick: number, alpha: number }

type Commands = {
	spawn: (self: Commands, components: { [string]: Fields }?) -> Entity,
	add: (self: Commands, entity: Entity, name: string, fields: Fields?) -> (),
	patch: (self: Commands, entity: Entity, name: string, fields: Fields) -> (),
	remove: (self: Commands, entity: Entity, name: string) -> (),
	despawn: (self: Commands, entity: Entity) -> (),
	setParent: (self: Commands, child: Entity, parent: Entity) -> (),
	removeParent: (self: Commands, child: Entity) -> (),
}

type Ctx = {
	query: () -> (Entity, ...any),
	views: () -> (Entity, { [string]: any }),
	side: Side,
	delta: number,
	fixedDelta: number,
	time: Time,
	commands: Commands,
	resources: { [string]: any },
	events: { read: EventRead, send: EventSend },
	call: Call,
	get: CtxGet,
	has: (self: Ctx, entity: Entity, name: string) -> boolean,
	getParent: (self: Ctx, entity: Entity) -> Entity?,
	getChildren: (self: Ctx, entity: Entity) -> { Entity },
	isEnabled: (self: Ctx, entity: Entity) -> boolean,
}

type Handle = {
	entity: Entity,
	getComponent: SelfGet,
	hasComponent: (self: Handle, name: string) -> boolean,
	getParent: (self: Handle) -> Handle?,
	getChildren: (self: Handle) -> { Handle },
	getHandle: (self: Handle, entity: Entity) -> Handle,
	addComponent: (self: Handle, name: string, fields: Fields?) -> (),
	removeComponent: (self: Handle, name: string) -> (),
	destroy: (self: Handle) -> (),
}

-- A Behaviour's self: its fields (any name), its entity, ctx, and the methods of a handle.
type Self = {
	entity: Entity,
	ctx: Ctx,
	getComponent: SelfGet,
	hasComponent: (self: Self, name: string) -> boolean,
	getParent: (self: Self) -> Handle?,
	getChildren: (self: Self) -> { Handle },
	getHandle: (self: Self, entity: Entity) -> Handle,
	addComponent: (self: Self, name: string, fields: Fields?) -> (),
	removeComponent: (self: Self, name: string) -> (),
	destroy: (self: Self) -> (),
	onStart: ((self: Self) -> ())?,
	onEnable: ((self: Self) -> ())?,
	onDisable: ((self: Self) -> ())?,
	onUpdate: ((self: Self, dt: number) -> ())?,
	onFixedUpdate: ((self: Self, dt: number) -> ())?,
	onDestroy: ((self: Self) -> ())?,
	[string]: any,
}

-- What a form takes first: a system's ctx, or a Behaviour's self.
type CtxLike = Ctx | Self

type Names = { string }
type Query = {
	read: Names?,
	write: Names?,
	optionalRead: Names?,
	optionalWrite: Names?,
	with: Names?,
	without: Names?,
	added: Names?,
	changed: Names?,
	removed: Names?,
}
type SystemSpec = {
	phase: Phase?,
	side: Side?,
	query: Query?,
	run: (ctx: Ctx) -> (),
	resources: { read: { string }?, write: { string }? }?,
	components: { read: Names?, write: Names? }?,
	events: { read: { string }?, send: { string }? }?,
	calls: { string }?,
	after: { string }?,
	before: { string }?,
	inState: { string }?,
	onEnter: { string }?,
	onExit: { string }?,
	whilePaused: boolean?,
}
