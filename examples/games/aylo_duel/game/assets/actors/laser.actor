[capsule format=1]

# A laser: a dynamic body flying at its Velocity, without gravity, never tunnelling through a thin wall (layer 2). The
# ship that fires it gives its position, its shooter, its direction and the ship it can hit (scripts/server/weapons.luau).
# Every client draws it flying right, and plays its sound once where it was fired; actors/laser_left.actor is the
# right player's, flying left.
[node path="."]
game.Laser = {}
aylo.Transform2D = {}
aylo.Collider = { size = (60, 12), layer = 2 }
aylo.RigidBody = { gravityScale = 0, fixedRotation = true, continuousCollision = true }
aylo.Velocity = {}
aylo.SpriteRenderer = { layer = 2 }
aylo.SpriteAnimator = { atlas = "atlases/laser.atlas", animation = "right" }
aylo.AudioSource = { sound = "laser.mp3" }
