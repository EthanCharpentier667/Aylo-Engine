[capsule format=1]

# A wall of the middle column: a static box the lasers stop on and the ships slide along (collision layer 1, the
# obstacles), drawn as its collider.
[node path="."]
aylo.Transform2D = {}
aylo.Collider = { size = (40, 140), layer = 1 }
aylo.ShapeRenderer = { kind = "rect", size = (40, 140), cornerRadius = 6, fillColor = (0.25, 0.27, 0.32, 1), outlineColor = (0.55, 0.6, 0.7, 1), outlineThickness = 2 }
