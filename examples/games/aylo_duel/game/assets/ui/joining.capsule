[capsule format=1]

# While the server finds a seat: a turning wheel (game.Spinner, scripts/client/menu.luau) and Cancel.
[node path="."]
game.ScreenNode = {}
aylo.UiNode = { width = "100%", height = "100%", justify = "center", alignItems = "center" }
aylo.UiBackground = { color = (0.01, 0.01, 0.04, 0.6) }

[node path="Panel" instance="ui/panel.capsule" side=client]

[node path="Panel/Title" side=client]
aylo.UiNode = { ignorePointer = true }
aylo.UiText = { text = "QUICK JOIN", font = "fonts/orbitron.json", size = 34, color = (1, 0.85, 0.3, 1), align = "center" }

# The loading wheel: 11 frames of 16x16 pixels in a row, the first shown.
[node path="Panel/Wheel" side=client]
game.Spinner = {}
aylo.UiNode = { width = 48, height = 48, marginTop = 8, marginBottom = 8, ignorePointer = true }
aylo.UiImage = { texture = "ui/loading_wheel.png", source = (0, 0, 16, 16) }

[node path="Panel/Looking" side=client]
aylo.UiNode = { ignorePointer = true }
aylo.UiText = { text = "Looking for a free seat...", font = "fonts/orbitron.json", size = 16, color = (0.7, 0.75, 0.9, 1), align = "center" }

[node path="Panel/Cancel" instance="ui/button.capsule" side=client]
aylo.UiButton = { action = "menu.cancel" }

[node path="Panel/Cancel/Label" side=client]
aylo.UiNode = { ignorePointer = true }
aylo.UiText = { text = "Cancel", font = "fonts/orbitron.json", size = 20, align = "center" }

[node path="Help" side=client]
aylo.UiNode = { position = "absolute", bottom = 16, ignorePointer = true }
aylo.UiText = { text = "WASD or the arrows to move, click to fire, Escape to go back", font = "fonts/orbitron.json", size = 13, color = (0.7, 0.75, 0.9, 1), align = "center" }
